# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# nested coding project secrets
coding/.env
coding/.env*
!coding/.env.example

# nested coding project generated files
coding/.next/
coding/node_modules/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
